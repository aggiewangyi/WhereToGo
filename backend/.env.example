# ---- MySQL ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=123456
DB_NAME=wheretogo

# ---- Redis ----
REDIS_URL=redis://127.0.0.1:6379/0

# ---- JWT ----
SECRET_KEY=change-me-to-a-random-secret-in-production

# ---- Agent HTTP ----
# ToC 用户走 JWT（/auth/login）；此项非空时，允许用 X-Agent-API-Key 走 AGENT_SERVICE_USER_ID（自动化/对内）
AGENT_SERVICE_API_KEY=
# 与 API Key 配对的服务账号 users.id（须存在）；网页用户不使用此项
AGENT_SERVICE_USER_ID=1

# ---- 302.AI (统一 AI 网关) ----
# 一个 API Key 即可调用: LLM / 搜索 / 翻译 / 小红书 等全部服务
# 申请地址: https://302.ai
API_302_KEY=your_api_key
API_302_BASE_URL=https://api.302.ai

# ---- LLM 模型 (通过 302.AI 调用) ----
# 可选: gpt-4o / claude-3.5-sonnet / deepseek-chat / qwen-turbo 等
DEFAULT_MODEL=gpt-4o

# ---- 对话模式 ----
# true=多智能体串联（意图→行程→行前）；false=单 ReAct Agent
CHAT_MULTI_AGENT=true
# 每轮对话后抽取满意/不满点写入 users.travel_memory（小模型调用，可关）
CHAT_FEEDBACK_MEMORY=true
# LangGraph SqliteSaver（空=进程内 MemorySaver）；示例：./data/langgraph_ckpt.sqlite
LANGGRAPH_SQLITE_PATH=
# 单次工具调用超时（秒），超时则跳过并继续对话
AGENT_TOOL_TIMEOUT_SEC=45
# LLM 单次 HTTP 请求超时（秒），避免 TLS 握手挂起时重试等待过长
AGENT_LLM_TIMEOUT_SEC=60
# 连接失败时最大重试次数（指数退避），默认 2 次 ≈ 最多等 ~30s
AGENT_LLM_RETRY=2
AGENT_LLM_RETRY_DELAY=2.0
# true=对话逐字流式（依赖上游 SSE）；false=整段生成（更稳，避免空流报错）
CHAT_STREAM_LLM=false

# ---- 外部服务 (直连，不经过 302.AI) ----
AMAP_API_KEY= your_api_key      # 高德地图
WEATHER_API_KEY=your_api_key      # 和风天气

# ---- 数据种子（可选）----
# poetry run python scripts/seed_destinations.py
